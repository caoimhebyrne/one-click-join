{
    "schemaVersion": 1,
    "id": "one-click-join",
    "version": "${version}",
    "name": "One Click Join",
    "description": "Instantly join your last Minecraft server from the main menu!",
    "authors": [
        "Caoimhe"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/one-click-join",
        "sources": "https://github.com/caoimhebyrne/one-click-join",
        "issues": "https://github.com/caoimhebyrne/one-click-join/issues"
    },
    "license": "MIT",
    "icon": "assets/one-click-join/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "dev.caoimhe.oneclickjoin.OneClickJoin"
        ]
    },
    "mixins": [
        "one-click-join.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": $minecraft_versions_array,
        "java": ">=${java_version}",
        "fabric-api": "*"
    }
}
